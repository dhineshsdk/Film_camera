#version 450

// Stages 4, 5, 6 Monolithic Wave32 Compute Shader:
// - Bug B3 Fixed: Universal CFA phase + True Vertical Laplacian Hamilton-Adams Demosaic
// - Bug B6 Fixed: Column-major transpose(mat3(...)) & Official SMPTE ST 2065-1 AP1 Matrix
// - Error E1 Fixed: ACES Reference Gamut Compression (RGC) without NaN
// - 32 KB LDS Verified: shared float s_tile[24][25] = 2,400 bytes (7.3% of 32 KB limit)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, r32f) uniform readonly image2D u_BayerIn;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_ACEScgOut;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D u_PreviewOut;

layout(std140, set = 0, binding = 3) uniform Stage6ColorUBO {
    mat4 camToACEScg; // 3x3 padded to mat4 (already column-major from C++)
    vec4 wbGains;     // [R_gain, G_gain, B_gain, exposureGain]
} u_Color;

layout(push_constant) uniform IspPC {
    uint width;
    uint height;
    uint cfaPhase;      // 0=RGGB (Cam 2), 1=GRBG (Cam 1/3), 2=GBRG (Cam 0 & Tele), 3=BGGR
    float clipThreshold;// 0.985
} pc;

#define TILE_DIM 24
#define HALO 4
// +1 padding eliminates 32-bank LDS conflicts on Xclipse 940 RDNA 3
shared float s_tile[TILE_DIM][TILE_DIM + 1];

uint getCfaChannel(ivec2 p, uint cfaPhase) {
    uint phase = ((uint(p.y) & 1u) << 1u) | (uint(p.x) & 1u);
    return phase ^ cfaPhase;
}

float loadBayerClamped(ivec2 p) {
    ivec2 c = clamp(p, ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
    c.x = (c.x & ~1) | (p.x & 1);
    c.y = (c.y & ~1) | (p.y & 1);
    return imageLoad(u_BayerIn, c).r;
}

// Error E1 Fix: Exact ACES 2.0 Reference Gamut Compression (RGC) in AP1
vec3 applyACESGamutCompression(vec3 rgb) {
    float ach = max(max(rgb.r, rgb.g), rgb.b);
    if (ach <= 1e-5) return rgb;
    vec3 dist = (ach - rgb) / ach;
    const vec3 t = vec3(0.815, 0.803, 0.880); // Cyan, Magenta, Yellow thresholds
    const vec3 l = vec3(1.147, 1.264, 1.312); // Asymptotic limits > 1.0 (Fixes NaN E1)
    const float p = 1.20;

    vec3 compDist;
    for (int i = 0; i < 3; ++i) {
        float v = dist[i];
        if (v < t[i]) {
            compDist[i] = v;
        } else {
            float s = (l[i] - t[i]) * pow(pow((1.0 - t[i]) / (l[i] - t[i]), -p) - 1.0, -1.0 / p);
            float x = (v - t[i]) / s;
            compDist[i] = t[i] + s * (x / pow(1.0 + pow(x, p), 1.0 / p));
        }
    }
    return ach * (1.0 - compDist);
}

// Oklab helpers for Stage 5 highlight chromaticity roll-off
vec3 linearSrgbToOklab(vec3 c) {
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    float l_ = pow(max(l, 0.0), 1.0 / 3.0);
    float m_ = pow(max(m, 0.0), 1.0 / 3.0);
    float s_ = pow(max(s, 0.0), 1.0 / 3.0);
    return vec3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
    );
}

vec3 oklabToLinearSrgb(vec3 lab) {
    float l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
    float m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    float s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;
    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;
    return vec3(
         4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    );
}

void main() {
    ivec2 groupBase = ivec2(gl_WorkGroupID.xy) * 16 - ivec2(HALO);
    uint tid = gl_LocalInvocationIndex;

    // Cooperatively load 24x24 = 576 elements across 256 threads
    for (uint i = tid; i < uint(TILE_DIM * TILE_DIM); i += 256u) {
        int ty = int(i / uint(TILE_DIM));
        int tx = int(i % uint(TILE_DIM));
        s_tile[ty][tx] = loadBayerClamped(groupBase + ivec2(tx, ty));
    }
    barrier();

    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    int lx = int(gl_LocalInvocationID.x) + HALO;
    int ly = int(gl_LocalInvocationID.y) + HALO;
    uint ch = getCfaChannel(p, pc.cfaPhase);
    float c_val = s_tile[ly][lx];

    // Stage 4: Hamilton-Adams Directional Demosaicing (Bug B3 Vertical Indexing Fixed!)
    vec3 rgb;
    if (ch == 0u || ch == 3u) {
        // At Red (0) or Blue (3) pixel: interpolate Green first using directional gradients
        float dH = abs(s_tile[ly][lx - 1] - s_tile[ly][lx + 1]) +
                   abs(2.0 * c_val - s_tile[ly][lx - 2] - s_tile[ly][lx + 2]);
        // Bug B3 Fix: True vertical ly - 2 and ly + 2 indexing!
        float dV = abs(s_tile[ly - 1][lx] - s_tile[ly + 1][lx]) +
                   abs(2.0 * c_val - s_tile[ly - 2][lx] - s_tile[ly + 2][lx]);

        float gH = 0.5 * (s_tile[ly][lx - 1] + s_tile[ly][lx + 1]) +
                   0.25 * (2.0 * c_val - s_tile[ly][lx - 2] - s_tile[ly][lx + 2]);
        float gV = 0.5 * (s_tile[ly - 1][lx] + s_tile[ly + 1][lx]) +
                   0.25 * (2.0 * c_val - s_tile[ly - 2][lx] - s_tile[ly + 2][lx]);

        float wH = 1.0 / (dH + 1e-4);
        float wV = 1.0 / (dV + 1e-4);
        float G = clamp((wH * gH + wV * gV) / (wH + wV), 0.0, 1.0);

        // Diagonal opposing chroma interpolation with second-order Green correction
        float diagSum = s_tile[ly - 1][lx - 1] + s_tile[ly - 1][lx + 1] +
                        s_tile[ly + 1][lx - 1] + s_tile[ly + 1][lx + 1];
        float opp = clamp(0.25 * diagSum + 0.25 * (4.0 * G - s_tile[ly][lx - 1] - s_tile[ly][lx + 1] - s_tile[ly - 1][lx] - s_tile[ly + 1][lx]), 0.0, 1.0);

        rgb = (ch == 0u) ? vec3(c_val, G, opp) : vec3(opp, G, c_val);
    } else {
        // At Green pixel: ch == 1 (Gr: R on left/right, B on top/bottom)
        //                 ch == 2 (Gb: B on left/right, R on top/bottom)
        float G = c_val;
        float h_interp = clamp(0.5 * (s_tile[ly][lx - 1] + s_tile[ly][lx + 1]) +
                               0.25 * (2.0 * G - s_tile[ly][lx - 2] - s_tile[ly][lx + 2]), 0.0, 1.0);
        // Bug B3 Fix: Vertical neighbor uses s_tile[ly - 2][lx] and s_tile[ly + 2][lx]!
        float v_interp = clamp(0.5 * (s_tile[ly - 1][lx] + s_tile[ly + 1][lx]) +
                               0.25 * (2.0 * G - s_tile[ly - 2][lx] - s_tile[ly + 2][lx]), 0.0, 1.0);

        rgb = (ch == 1u) ? vec3(h_interp, G, v_interp) : vec3(v_interp, G, h_interp);
    }

    // Stage 5: Clipped Highlight Reconstruction & Oklab Roll-Off
    bool gClipped = (rgb.g >= pc.clipThreshold);
    vec3 wbRgb = rgb * u_Color.wbGains.rgb;
    if (gClipped && (rgb.r < pc.clipThreshold || rgb.b < pc.clipThreshold)) {
        wbRgb.g = max(wbRgb.g, 0.5 * (wbRgb.r + wbRgb.b));
    }

    // Stage 6: Transform Camera RGB -> Linear ACEScg (AP1, D60) (Bug B6 Fixed)
    vec3 acescg = mat3(u_Color.camToACEScg) * wbRgb * u_Color.wbGains.w;
    acescg = max(acescg, vec3(0.0));

    // Oklab chromaticity roll-off near highlight saturation to eliminate magenta clipping
    vec3 lab = linearSrgbToOklab(acescg);
    if (lab.x > 0.95) {
        float roll = clamp((1.25 - lab.x) / 0.30, 0.0, 1.0);
        lab.yz *= (roll * roll);
        acescg = max(oklabToLinearSrgb(lab), vec3(0.0));
    }

    // Apply Error E1 Fixed ACES Reference Gamut Compression
    acescg = applyACESGamutCompression(acescg);
    imageStore(u_ACEScgOut, p, vec4(acescg, 1.0));

    // Convert Linear ACEScg (AP1) -> Display sRGB / P3 with neutral shoulder for Phase 2 preview
    // (Bug B6 Fix: transpose(mat3(...)) for row-major literal matrix)
    const mat3 M_AP1_to_sRGB = transpose(mat3(
         1.7050515, -0.6217921, -0.0832594,
        -0.1302564,  1.1408048, -0.0105484,
        -0.0240033, -0.1289690,  1.1529723
    ));
    vec3 srgbLin = max(M_AP1_to_sRGB * acescg, vec3(0.0));
    // Smooth hyperbolic shoulder + sRGB EOTF
    vec3 mapped = srgbLin / (1.0 + srgbLin);
    vec3 displayRgb = pow(clamp(mapped, 0.0, 1.0), vec3(1.0 / 2.2));
    imageStore(u_PreviewOut, p, vec4(displayRgb, 1.0));
}
