<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.s24film.camera">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.raw" />
    <uses-feature android:name="android.hardware.vulkan.version" android:value="0x00403000" />

    <application
        android:label="S24Film Camera"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name="com.s24film.camera.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.s24film.camera.LibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.s24film.camera.EditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
