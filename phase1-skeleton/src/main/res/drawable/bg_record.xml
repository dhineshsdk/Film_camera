<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#66FFFFFF" /><solid android:color="#00000000" /></shape></item>
            <item android:inset="10dp"><shape android:shape="oval"><solid android:color="#66FF3B30" /></shape></item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /><solid android:color="#00000000" /></shape></item>
            <item android:inset="24dp"><shape android:shape="rectangle"><solid android:color="@color/rec_red" /><corners android:radius="6dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /><solid android:color="#00000000" /></shape></item>
            <item android:inset="10dp"><shape android:shape="oval"><solid android:color="@color/rec_red" /></shape></item>
        </layer-list>
    </item>
</selector>
