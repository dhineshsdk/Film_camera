<?xml version="1.0" encoding="utf-8"?>
<!-- Active film: outlined gold pill at the head of the film strip -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#40FFC845" /><stroke android:width="1.2dp" android:color="@color/accent" /><corners android:radius="15dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#1FFFC845" /><stroke android:width="1.2dp" android:color="#B3FFC845" /><corners android:radius="15dp" /></shape>
    </item>
</selector>
