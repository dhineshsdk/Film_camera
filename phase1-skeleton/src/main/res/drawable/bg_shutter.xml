<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#66FFFFFF" /><solid android:color="#00000000" /></shape></item>
            <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"><shape android:shape="oval"><solid android:color="#66FFFFFF" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /><solid android:color="#00000000" /></shape></item>
            <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp"><shape android:shape="oval"><solid android:color="#FFD9D9D9" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /><solid android:color="#00000000" /></shape></item>
            <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
