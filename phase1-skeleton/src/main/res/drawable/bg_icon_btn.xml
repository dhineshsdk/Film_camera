<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon button on the black bands; gold glass when its feature is on -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#40FFFFFF" /></shape></item>
    <item android:state_selected="true"><shape android:shape="oval"><solid android:color="@color/accent_soft" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="#1AFFFFFF" /></shape></item>
</selector>
