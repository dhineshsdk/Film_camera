#version 450

// =============================================================================
// S24+ Exynos 2400 (Xclipse 940 AMD RDNA 3) Wave32 Multi-Pass RAW ISP & Film Engine
// Sprint 1: Split-Speed Multi-Pass Vulkan 1.3 Engine
//
// One SPIR-V module, five compute pipelines selected by specialization constant 0
// (keeps the existing demosaic.comp -> demosaic_spv.h build step unchanged):
//
//   STAGE 0  PREP     sensor res   GAT + Makitalo-Foi inverse, 4-frame ring merge,
//                                  17x13x4 lens shading -> clean Bayer buffer
//   STAGE 1  ISP      output res   Hamilton-Adams demosaic, WB, Oklab highlight recovery,
//                                  ForwardMatrix -> ACEScg, ACES RGC -> mLinearAcesImage mip 0
//   STAGE 2  PYRAMID  per level    5-level Gaussian mip pyramid of mLinearAcesImage
//   STAGE 3  BOKEH    half / full  Super 70mm (52.5 x 23 mm, 80 mm f/2.0) 64-tap gather; master with a
//                                  depth map: scatter-as-gather over the signed CoC map (STAGE 5)
//   STAGE 5  DEPTH    output res   master only: monocular disparity -> signed CoC map (joint bilateral upsample)
//   STAGE 4  FILM     output res   TIR halation + Pro-Mist diffusion from the pyramid,
//                                  120-look spectral matrix + 2D LUT, DIR couplers,
//                                  Gabor tile grain (live) / Newson Boolean grain (master),
//                                  print / scanner inversion, Ultra HDR gain in alpha (master)
// =============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(constant_id = 0) const uint STAGE = 1u;

const uint STAGE_PREP    = 0u;
const uint STAGE_ISP     = 1u;
const uint STAGE_PYRAMID = 2u;
const uint STAGE_BOKEH   = 3u;
const uint STAGE_FILM    = 4u;
const uint STAGE_DEPTH   = 5u;

const uint FLAG_MASTER  = 1u;  // offline master still render
const uint FLAG_SPATIAL = 2u;  // PREP: spatial Wiener shrinkage in the Anscombe domain
const uint FLAG_GAT     = 4u;  // PREP: Generalized Anscombe Transform path
const uint FLAG_LSC     = 8u;  // PREP: 17x13x4 lens shading correction

// ---------------------------------------------------------------- shared resources
layout(std430, binding = 0) readonly buffer RawInputBuffer {
    uint u_raw_data[];          // 4-slot ring of packed uint16 RAW_SENSOR frames
};

layout(std430, binding = 1) buffer CleanBayerBuffer {
    float u_clean[];            // rawW * rawH, black-subtracted, denoised, shading-corrected
};

layout(std430, binding = 2) readonly buffer LscBuffer {
    float u_lsc[];              // kS24LensShadingGrids[4][884], [row][col][R,Geven,Godd,B]
};

layout(binding = 3) uniform sampler2D u_look_lut;    // 256 x 120 s24_master_120_looks.bin
layout(binding = 4) uniform sampler2D u_grain_tile;  // 512 x 512 tileable Gabor noise (REPEAT)

struct LookGpu {
    vec4 dMax;      // rgb
    vec4 gamma;     // rgb
    vec4 dMid;      // rgb density at log10(E/0.18) = 0
    vec4 m0;        // spectralMatrix row 0
    vec4 m1;        // spectralMatrix row 1
    vec4 m2;        // spectralMatrix row 2
    vec4 misc;      // x=category, y=mode (0 negative, 1 transmission, 2 encoded), z=DIR boost, w=LUT row
    vec4 misc2;     // x=LUT normalized (1) / absolute (0), y=halation, z=grain, w=unused
    vec4 print0;    // xyz=printer-light logE offset per layer, w=print LUT row (< 0: no print stage)
    vec4 print1;    // xyz=print paper D-min, w=print exposure scale
    vec4 print2;    // xyz=rendered black (subtracted), w=mid-grey normalisation
};

layout(std430, binding = 5) readonly buffer LookBuffer {
    LookGpu u_looks[];
};

// Spectral film model tables for the active look (SpectralFilm.h): [0] look index (-1 none),
// [1] type (0 negative, 1 slide, 2 B&W), [2] log E offset, [3] print N, [4..6] density axis max,
// [7] camera grid N, [8] curve N; camera table, curves and print table follow from float 16.
layout(std430, binding = 18) readonly buffer SpectralBuffer {
    float u_spec[];
};

layout(std140, binding = 6) uniform FrameParams {
    vec4 f_noise;    // x=S, y=O (normalized to [0,1] after black), z=black level DN, w=temporal tolerance
    vec4 f_lsc;      // x=enable, y=grid cols (17), z=grid rows (13), w=normalized RAW -> AP1 gain (noise scale)
    vec4 f_look;     // x=look index (<0 = legacy GeneratedFilmDatabase path), y=DIR multiplier, z=print contrast, w=LUT logE min
    vec4 f_look2;    // x=LUT logE max, y=LUT rows, z=LUT cols, w=spectral crosstalk strength
    vec4 f_optics;   // x=halation threshold, y=halation strength, z=diffusion strength, w=diffusion threshold
    vec4 f_halW;     // halation weights for mip 1..4
    vec4 f_halW2;    // x=halation weight for mip 5, y=film format blur sigma (px), z=gate vignette
    vec4 f_diffW;    // diffusion weights for mip 1..4
    vec4 f_diffW2;   // x=diffusion weight for mip 5
    vec4 f_bokeh;    // x=enable, y=CoC radius at infinity (output px), z=focus u, w=focus v
    vec4 f_bokeh2;   // x=in-focus radius, y=falloff radius (fraction of height), z=push(+)/pull(-) stops, w=tap count
    vec4 f_grain;    // x=luma sharpening amount, y=grain tile texel size in output px, z=strength, w=format grain gain
    vec4 f_hdr;      // x=hdrSdrRatio, y=write gain to alpha, z=chroma NR strength, w=luma NR strength
    vec4 f_lens;     // x=Petzval swirl, y=thorium warmth, z=W040 glow, w=cos4 vignette
    vec4 f_fm0;      // CCT-interpolated ForwardMatrix rows (WB camera RGB -> XYZ D50); f_fm0.w = valid
    vec4 f_fm1;
    vec4 f_fm2;
    vec4 f_lfx0;     // lens: x=ghosts, y=halo, z=anamorphic streak, w=streak length (uv)
    vec4 f_lfx1;     // lens: rgb=streak tint, w=veiling glare
    vec4 f_lfx2;     // lens: x=lateral CA, y=distortion k1, z=swirl, w=starburst
    vec4 f_lfx3;     // lens: x=iris blades, y=f-number, z=anamorphic squeeze, w=unused
    vec4 f_lfx4;     // lens: rgb=coating tint, w=flare threshold (scene-linear)
};

