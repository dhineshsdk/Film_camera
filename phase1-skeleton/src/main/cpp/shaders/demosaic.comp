    uint u_frame_seed;         // 44
    float u_dmax_r;            // 48
    float u_dmax_g;            // 52
    float u_dmax_b;            // 56
    float u_nu;                // 60
    float u_gamma_r;           // 64
    float u_gamma_g;           // 68
    float u_gamma_b;           // 72
