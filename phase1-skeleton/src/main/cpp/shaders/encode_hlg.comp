#version 450
// Video encoder pass: crops and scales the live film frame (sRGB-encoded BT.709, SDR) to the
// encoder size and re-encodes it as BT.2020 HLG for 10-bit HEVC (BT.2408 SDR-in-HLG mapping:
// SDR diffuse white lands on 75% HLG signal, 203 cd/m2 on a 1000 cd/m2 display).
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16f) readonly uniform image2D u_src;    // live viewfinder image
layout(binding = 1, rgba16f) writeonly uniform image2D u_dst;   // encoder-sized staging image

layout(push_constant) uniform Push {
    vec4 srcRect;    // x0, y0, width, height in source pixels
    ivec2 dstSize;
    ivec2 srcSize;
} pc;

vec3 srgbEotf(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v / 12.92, pow((v + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), v));
}

vec3 hlgOetf(vec3 e) {
    const float a = 0.17883277, b = 0.28466892, c = 0.55991073;
    e = max(e, vec3(0.0));
    vec3 lo = sqrt(3.0 * e);
    vec3 hi = a * log(max(12.0 * e - b, vec3(1e-6))) + c;
    return mix(lo, hi, step(vec3(1.0 / 12.0), e));
}

vec3 fetch(ivec2 q) {
    return imageLoad(u_src, clamp(q, ivec2(0), pc.srcSize - 1)).rgb;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.dstSize.x || p.y >= pc.dstSize.y) return;

    // Bilinear sample at the destination pixel centre.
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.dstSize);
    vec2 s = pc.srcRect.xy + uv * pc.srcRect.zw - 0.5;
    ivec2 i0 = ivec2(floor(s));
    vec2 f = s - vec2(i0);
    vec3 c00 = fetch(i0), c10 = fetch(i0 + ivec2(1, 0));
    vec3 c01 = fetch(i0 + ivec2(0, 1)), c11 = fetch(i0 + ivec2(1, 1));
    vec3 srgb = mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);

    // Display-linear BT.709 -> BT.2020 (ITU-R BT.2087).
    const mat3 m709to2020 = mat3(
        0.6274, 0.0691, 0.0164,
        0.3293, 0.9195, 0.0880,
        0.0433, 0.0114, 0.8956);
    vec3 disp = max(m709to2020 * srgbEotf(srgb), vec3(0.0)) * (203.0 / 1000.0);

    // Inverse HLG OOTF (system gamma 1.2 at 1000 cd/m2), then the HLG OETF.
    float yd = dot(disp, vec3(0.2627, 0.6780, 0.0593));
    vec3 scene = (yd > 1e-6) ? disp * pow(yd, (1.0 - 1.2) / 1.2) : vec3(0.0);
    imageStore(u_dst, p, vec4(hlgOetf(scene), 1.0));
}
