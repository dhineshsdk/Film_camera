#version 450

// =============================================================================
// S24+ Exynos 2400 (Xclipse 940 AMD RDNA 3) Wave32 Unified RAW ISP & Film Engine
// Phase 5 Cinema Video & Calibrated Darkroom Edition
// - Preserves Phase 4 Samsung Reference WB Calibration & 1:1 Aspect Ratio Crop
// - Adds Real-Time Anamorphic De-Squeeze (1.0x, 1.33x, 2.0x) & 2.39:1 / 16:9 Cinema Gates
// - Adds Mechanical Film Gate Weave & Wong Kar-wai Step-Printing Cadence
// - Dual-Swapchain Zero-Copy Blit to Viewfinder + Exynos Hardware HEVC Encoder
// =============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer RawInputBuffer {
    uint u_raw_data[];
};

layout(binding = 1, rgba8) writeonly uniform image2D u_output_image;

layout(push_constant) uniform PushConstants {
    uint u_width;              // 0
    uint u_height;             // 4
    uint u_stride;             // 8  (in uint16 elements)
    uint u_cfa_phase;          // 12 (0=RGGB, 1=GRBG, 2=GBRG, 3=BGGR)
    float u_white_level;       // 16 (1023.0)
    float u_gain_r;            // 20
    float u_gain_g;            // 24
    float u_gain_b;            // 28
    uint u_sensor_orientation; // 32 (0, 90, 180, 270 auto-rotated from IMU gravity)
    uint u_stock_type;         // 36 (0=ACEScg, 1=ColorNeg, 2=BWNeg, 3=Cine2383, 4=Slide, 5=Aerochrome, 6=ARRI_LogC4)
    uint u_lens_type;          // 40 (0=Clean, 1=Helios Swirl, 2=Leica Glow, 3=Thorium, 4=Anamorphic)
    uint u_frame_seed;         // 44
    float u_dmax_r;            // 48
    float u_dmax_g;            // 52
    float u_dmax_b;            // 56
    float u_nu;                // 60
    float u_gamma_r;           // 64
    float u_gamma_g;           // 68
    float u_gamma_b;           // 72
    float u_dir_sat_boost;     // 76
    float u_print_gamma_r;     // 80
    float u_print_gamma_g;     // 84
    float u_print_gamma_b;     // 88
    float u_grain_strength;    // 92 (Scaled by user Grain slider)
    float u_halation_strength; // 96 (Scaled by user Halation slider)
    float u_exposure_scale;    // 100 (Scaled by user EV / Push-Pull slider)
    uint u_cam_matrix_idx;     // 104 (0=Wide, 1=Front, 2=UW, 3=Tele)
    uint u_packed_ring_info;   // 108 (bits 0..1=activeSlot, bits 8..15=burstCount, bit 16=mirrorFront,
                               //      bits 17..18=anamorphicMode [0=1.0x, 1=1.33x, 2=2.0x],
                               //      bits 19..20=cinemaGate [0=3:4, 1=16:9, 2=2.39:1],
                               //      bit 21=gateWeaveEnabled)
};

float fetchBayerSlot(int x, int y, uint slot) {
    int cx = clamp(x, 0, int(u_width) - 1);
    int cy = clamp(y, 0, int(u_height) - 1);
    cx = (cx & ~1) | (x & 1);
    cy = (cy & ~1) | (y & 1);
    uint framePitch16 = u_stride * u_height;
    uint idx16 = (slot & 3u) * framePitch16 + uint(cy) * u_stride + uint(cx);
    uint word = u_raw_data[idx16 >> 1u];
    uint val16 = ((idx16 & 1u) != 0u) ? (word >> 16u) : (word & 0xFFFFu);
    return clamp(float(val16) / max(u_white_level, 1.0), 0.0, 1.0);
}

float fetchBayerFast(int x, int y) {
    uint activeSlot = u_packed_ring_info & 3u;
    return fetchBayerSlot(x, y, activeSlot);
}

float fetchBayerBurstCenter(int x, int y) {
    uint activeSlot = u_packed_ring_info & 3u;
    uint burstCount = (u_packed_ring_info >> 8u) & 0xFFu;
    float refVal = fetchBayerSlot(x, y, activeSlot);
    if (burstCount <= 1u) return refVal;

    float sum = refVal;
    float wSum = 1.0;
    float localVar = max(0.004 * refVal + 0.0002, 1e-5);
    for (uint s = 1u; s < burstCount; ++s) {
        uint slot = (activeSlot + s) & 3u;
        float altVal = fetchBayerSlot(x, y, slot);
        float diff = altVal - refVal;
        float w = exp(-(diff * diff) / (3.0 * localVar));
        sum += w * altVal;
        wSum += w;
    }
    return sum / wSum;
}

uint getCfaChannel(int x, int y) {
    uint phase = ((uint(y) & 1u) << 1u) | (uint(x) & 1u);
    return phase ^ u_cfa_phase;
}

vec3 demosaicAt(int x, int y) {
    float c00 = fetchBayerBurstCenter(x, y);
    uint ch = getCfaChannel(x, y);

    float n0 = fetchBayerFast(x - 2, y);
    float n1 = fetchBayerFast(x + 2, y);
    float n2 = fetchBayerFast(x, y - 2);
    float n3 = fetchBayerFast(x, y + 2);
    float maxN = max(max(n0, n1), max(n2, n3));
    float avgN = 0.25 * (n0 + n1 + n2 + n3);

    float cW1 = fetchBayerFast(x - 1, y);
    float cE1 = fetchBayerFast(x + 1, y);
    float cN1 = fetchBayerFast(x, y - 1);
    float cS1 = fetchBayerFast(x, y + 1);
    float psiSpec = (cW1 + cE1 + cN1 + cS1) / (4.0 * avgN + 1e-4);
    if (c00 > maxN + 0.14 && psiSpec < 0.15) {
        c00 = avgN;
    }

    vec3 rgb;
    if (ch == 0u || ch == 3u) {
        float dH = abs(cW1 - cE1) + abs(2.0 * c00 - n0 - n1);
        float dV = abs(cN1 - cS1) + abs(2.0 * c00 - n2 - n3);
        float gH = 0.5 * (cW1 + cE1) + 0.25 * (2.0 * c00 - n0 - n1);
        float gV = 0.5 * (cN1 + cS1) + 0.25 * (2.0 * c00 - n2 - n3);
        float wH = 1.0 / (dH + 1e-4);
        float wV = 1.0 / (dV + 1e-4);
        float G = clamp((wH * gH + wV * gV) / (wH + wV), 0.0, 1.0);

        float dNW = fetchBayerFast(x - 1, y - 1);
        float dNE = fetchBayerFast(x + 1, y - 1);
        float dSW = fetchBayerFast(x - 1, y + 1);
        float dSE = fetchBayerFast(x + 1, y + 1);
        float opp = clamp(0.25 * (dNW + dNE + dSW + dSE) + 0.25 * (4.0 * G - cW1 - cE1 - cN1 - cS1), 0.0, 1.0);
        rgb = (ch == 0u) ? vec3(c00, G, opp) : vec3(opp, G, c00);
    } else {
        float G = mix(c00, avgN, 0.12);
        float hVal = clamp(0.5 * (cW1 + cE1) + 0.25 * (2.0 * G - n0 - n1), 0.0, 1.0);
        float vVal = clamp(0.5 * (cN1 + cS1) + 0.25 * (2.0 * G - n2 - n3), 0.0, 1.0);
        rgb = (ch == 1u) ? vec3(hVal, G, vVal) : vec3(vVal, G, hVal);
    }
    return rgb;
}

vec3 cameraRgbToACEScg(vec3 wbRgb) {
    mat3 fm;
    if (u_cam_matrix_idx == 1u) {
        fm = transpose(mat3(
             0.6951,  0.0156,  0.2535,
             0.2695,  0.6885,  0.0420,
             0.0033, -0.3702,  1.1918
        ));
    } else if (u_cam_matrix_idx == 2u) {
        fm = transpose(mat3(
             0.6553,  0.2451,  0.0635,
             0.2393,  0.9141, -0.1533,
             0.0391, -0.4316,  1.2188
        ));
    } else if (u_cam_matrix_idx == 3u) {
        fm = transpose(mat3(
             0.5967,  0.2734,  0.0938,
             0.2178,  0.8975, -0.1162,
             0.0225, -0.3535,  1.1553
        ));
    } else {
        fm = transpose(mat3(
             0.6240,  0.2520,  0.0889,
             0.2168,  0.8779, -0.0947,
             0.0117, -0.4023,  1.2148
        ));
    }

    const mat3 M_XYZ_D50_to_ACEScg = transpose(mat3(
         1.7048586, -0.3217799, -0.2367812,
        -0.6723159,  1.6129003,  0.0177516,
         0.0110566, -0.0082800,  0.9886214
    ));
    return max(M_XYZ_D50_to_ACEScg * (fm * wbRgb), vec3(0.0));
}

vec3 applyACESGamutCompression(vec3 rgb) {
    float ach = max(max(rgb.r, rgb.g), rgb.b);
    if (ach <= 1e-5) return rgb;
    vec3 dist = (ach - rgb) / ach;
    const vec3 t = vec3(0.815, 0.803, 0.880);
    const vec3 l = vec3(1.147, 1.264, 1.312);
    const float p = 1.20;
    vec3 comp;
    for (int i = 0; i < 3; ++i) {
        float v = dist[i];
        if (v < t[i]) {
            comp[i] = v;
        } else {
            float s = (l[i] - t[i]) * pow(pow((1.0 - t[i]) / (l[i] - t[i]), -p) - 1.0, -1.0 / p);
            float x = (v - t[i]) / s;
            comp[i] = t[i] + s * (x / pow(1.0 + pow(x, p), 1.0 / p));
        }
    }
    return ach * (1.0 - comp);
}

vec3 evaluateRichardsHD(vec3 logE, vec3 dMax, vec3 gamma, float nuVal, float polarityS) {
    float n = max(nuVal, 0.1);
    vec3 D;
    for (int c = 0; c < 3; ++c) {
        float span = max(dMax[c], 0.1);
        float k = (gamma[c] / span) * pow(1.0 + n, (1.0 + n) / n);
        float arg = clamp(-polarityS * k * logE[c], -35.0, 35.0);
        D[c] = span / pow(1.0 + n * exp(arg), 1.0 / n);
    }
    return D;
}

uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}

vec3 hash3f(uvec3 s) {
    return vec3(pcg3d(s)) * (1.0 / 4294967295.0);
}

vec3 applyDensityGrain(vec2 coord, vec3 D, vec3 dMax, float strength) {
    if (strength <= 0.001) return D;
    vec3 normD = clamp(D / max(dMax, vec3(0.1)), 0.0, 1.0);
    vec3 env = 4.0 * normD * (1.0 - normD) + 0.14;
    vec3 noise = vec3(0.0);
    float freq = 0.52;
    float amp = 0.75;
    for (int oct = 0; oct < 2; ++oct) {
        uvec3 seed = uvec3(uint(coord.x * freq), uint(coord.y * freq), u_frame_seed + uint(oct * 73));
        noise += (hash3f(seed) * 2.0 - 1.0) * amp;
        freq *= 2.0;
        amp *= 0.50;
    }
    return clamp(D + noise * env * (strength * 0.20), vec3(0.0), dMax);
}

// ARRI LogC4 Curve (for clean 10-bit / Log cinema recording & grading)
vec3 linearToArriLogC4(vec3 x) {
    const float a = 278.506786;
    const float b = 0.90713587;
    const float c = 0.092864125;
    const float s = 0.1135972;
    const float t = -0.018056996;
    vec3 v = max(x, vec3(t));
    vec3 logPart = (log2(a * v + 64.0) - 6.0) / 14.0 * b + c;
    vec3 linPart = (v - t) / s;
    return mix(linPart, logPart, greaterThanEqual(v, vec3(t)));
}

vec3 acesFilmicODT(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(u_output_image);
    if (outCoord.x >= outSize.x || outCoord.y >= outSize.y) return;

    // Decode Cinema Gate & Anamorphic De-Squeeze flags from u_packed_ring_info
    uint anamorphicMode = (u_packed_ring_info >> 17u) & 3u; // 0=1.0x, 1=1.33x, 2=2.0x
    uint cinemaGate     = (u_packed_ring_info >> 19u) & 3u; // 0=3:4, 1=16:9, 2=2.39:1
    bool gateWeave      = ((u_packed_ring_info >> 21u) & 1u) != 0u;

    float targetHeight = float(outSize.x) * (4.0 / 3.0);
    if (cinemaGate == 1u) {
        // 16:9 Widescreen Cinema Gate
        targetHeight = float(outSize.x) * (9.0 / 16.0);
    } else if (cinemaGate == 2u) {
        // 2.39:1 Anamorphic Scope Cinema Gate
        targetHeight = float(outSize.x) / 2.39;
    }

    float yMargin = max(0.0, (float(outSize.y) - targetHeight) * 0.5);
    if (float(outCoord.y) < yMargin || float(outCoord.y) >= float(outSize.y) - yMargin) {
        imageStore(u_output_image, outCoord, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    float u_norm = (float(outCoord.x) + 0.5) / float(outSize.x);
    float v_norm = (float(outCoord.y) - yMargin + 0.5) / targetHeight;

    // Stage 8 Mechanical Film Gate Weave (subtle pin-registration jitter during Cinema Mode)
    if (gateWeave) {
        vec3 j = hash3f(uvec3(u_frame_seed, 17u, 53u)) - 0.5;
        u_norm = clamp(u_norm + j.x * 0.0014, 0.0, 1.0);
        v_norm = clamp(v_norm + j.y * 0.0014, 0.0, 1.0);
    }

    // Real-Time Anamorphic Horizontal De-Squeeze (1.33x or 2.0x Panavision)
    float desqueeze = (anamorphicMode == 1u) ? 1.33 : ((anamorphicMode == 2u) ? 2.0 : 1.0);
    if (desqueeze > 1.01) {
        v_norm = clamp(0.5 + (v_norm - 0.5) / desqueeze, 0.0, 1.0);
    }

    vec2 centered = (vec2(u_norm, v_norm) - 0.5) * vec2(1.0, 4.0 / 3.0);
    float r2 = dot(centered, centered);
    if (u_lens_type == 1u) {
        float swirl = 0.025 * r2;
        u_norm = clamp(u_norm - centered.y * swirl, 0.0, 1.0);
        v_norm = clamp(v_norm + centered.x * swirl, 0.0, 1.0);
    }

    // Phase 4 Verified Natural 1:1 Pixel Aspect Ratio Crop
    float cropW = float(u_height) * 0.75;
    float cropMarginX = max(0.0, (float(u_width) - cropW) * 0.5);

    int rawX, rawY;
    bool mirrorFront = ((u_packed_ring_info >> 16u) & 1u) != 0u;
    float u_eff = mirrorFront ? (1.0 - u_norm) : u_norm;

    if (u_sensor_orientation == 180u) {
        rawX = int(cropMarginX + (1.0 - u_eff) * cropW);
        rawY = int(float(u_height - 1) - v_norm * float(u_height - 1));
    } else if (u_sensor_orientation == 270u) {
        rawX = int(float(u_width - 1) - v_norm * float(u_width - 1));
        rawY = int(u_eff * float(u_height - 1));
    } else if (u_sensor_orientation == 90u) {
        rawX = int(v_norm * float(u_width - 1));
        rawY = int((1.0 - u_eff) * float(u_height - 1));
    } else {
        rawX = int(cropMarginX + u_eff * cropW);
        rawY = int(v_norm * float(u_height - 1));
    }

    vec3 camRgb = demosaicAt(rawX, rawY);
    bool gClipped = (camRgb.g >= 0.985);
    vec3 wbRgb = camRgb * vec3(u_gain_r, u_gain_g, u_gain_b);
    if (gClipped && (camRgb.r < 0.985 || camRgb.b < 0.985)) {
        wbRgb.g = max(wbRgb.g, 0.5 * (wbRgb.r + wbRgb.b));
    }

    vec3 acescg = cameraRgbToACEScg(wbRgb) * u_exposure_scale;
    acescg = applyACESGamutCompression(acescg);

    if (u_lens_type == 3u) {
        acescg *= vec3(1.06, 1.00, 0.80);
    }

    if (u_halation_strength > 0.01 || u_lens_type == 2u || u_lens_type == 4u) {
        int rx = (rawX & ~1) + ((u_cfa_phase == 1u || u_cfa_phase == 3u) ? 1 : 0);
        int ry = (rawY & ~1) + ((u_cfa_phase == 2u || u_cfa_phase == 3u) ? 1 : 0);
        float rHalo = 0.25 * (
            fetchBayerFast(rx + 24, ry) + fetchBayerFast(rx - 24, ry) +
            fetchBayerFast(rx, ry + 24) + fetchBayerFast(rx, ry - 24)
        ) * u_gain_r * u_exposure_scale;
        float gHalo = 0.25 * (
            fetchBayerFast(rx + 14, ry + 12) + fetchBayerFast(rx - 14, ry + 12) +
            fetchBayerFast(rx + 14, ry - 12) + fetchBayerFast(rx - 14, ry - 12)
        ) * u_gain_g * u_exposure_scale;

        vec3 overHalo = max(vec3(rHalo, gHalo, 0.0) - vec3(0.38), vec3(0.0));
        if (u_halation_strength > 0.01) {
            const mat3 M_hal = transpose(mat3(
                1.35, 0.12, 0.00,
                0.25, 0.40, 0.00,
                0.00, 0.00, 0.00
            ));
            acescg += (M_hal * overHalo) * u_halation_strength * 1.7;
        }
        if (u_lens_type == 2u) {
            acescg += vec3(overHalo.g) * 0.32;
        } else if (u_lens_type == 4u) {
            acescg += max(overHalo.r, overHalo.g) * vec3(0.06, 0.25, 0.92);
        }
    }

    vec3 linearOut = acescg;
    if (u_stock_type > 0u) {
        vec3 dMax = vec3(u_dmax_r, u_dmax_g, u_dmax_b);
        vec3 gamma = vec3(u_gamma_r, u_gamma_g, u_gamma_b);
        vec3 pGamma = vec3(u_print_gamma_r, u_print_gamma_g, u_print_gamma_b);

        if (u_stock_type == 5u) {
            float ndvi = clamp((acescg.g - 0.65 * acescg.r) / max(acescg.g + 0.65 * acescg.r, 1e-4), 0.0, 1.0);
            float nir = acescg.g * (1.0 + 1.8 * ndvi);
            acescg = vec3(0.10 * acescg.r + 0.90 * nir, 0.88 * acescg.r + 0.12 * acescg.g, 0.15 * acescg.r + 0.85 * acescg.b);
        }

        if (u_stock_type == 2u) {
            float bwE = max(dot(acescg, vec3(0.245, 0.612, 0.143)), 1e-5);
            vec3 logE = vec3(log(bwE / 0.18) * 0.4342944819);
            vec3 dNeg = evaluateRichardsHD(logE, dMax, gamma, u_nu, 1.0);
            vec3 dMid = evaluateRichardsHD(vec3(0.0), dMax, gamma, u_nu, 1.0);
            dNeg = applyDensityGrain(vec2(outCoord), dNeg, dMax, u_grain_strength);
            vec3 pos = 0.18 * pow(vec3(10.0), pGamma * (dNeg - dMid));
            linearOut = vec3(pos.g);
        } else if (u_stock_type == 4u) {
            vec3 logE = log(max(acescg / 0.18, vec3(1e-5))) * 0.4342944819;
            vec3 dSlide = evaluateRichardsHD(logE, dMax, gamma * 0.45, u_nu, -1.0);
            vec3 dMid   = evaluateRichardsHD(vec3(0.0), dMax, gamma * 0.45, u_nu, -1.0);
            dSlide = applyDensityGrain(vec2(outCoord), dSlide, dMax, u_grain_strength);
            linearOut = 0.18 * pow(vec3(10.0), -(dSlide - dMid));
        } else {
            vec3 logE = log(max(acescg / 0.18, vec3(1e-5))) * 0.4342944819;
            vec3 dNeg = evaluateRichardsHD(logE, dMax, gamma, u_nu, 1.0);
            vec3 dMid = evaluateRichardsHD(vec3(0.0), dMax, gamma, u_nu, 1.0);
            dNeg = applyDensityGrain(vec2(outCoord), dNeg, dMax, u_grain_strength);

            vec3 deltaD = dNeg - dMid;
            float s = u_dir_sat_boost;
            float off = (1.0 - s) * 0.5;
            mat3 M_dir = transpose(mat3(
                s,   off, off,
                off, s,   off,
                off, off, s
            ));
            deltaD = M_dir * deltaD;
            linearOut = 0.18 * pow(vec3(10.0), pGamma * deltaD);

            if (u_stock_type == 1u) {
                linearOut = mix(linearOut, linearOut * vec3(1.05, 1.00, 0.94), 0.55);
            } else if (u_stock_type == 3u) {
                float luma = dot(linearOut, vec3(0.2722, 0.6741, 0.0537));
                float sh = clamp(1.0 - luma * 3.0, 0.0, 1.0);
                linearOut = linearOut * (1.0 - 0.18 * sh) + sh * vec3(0.005, 0.018, 0.028);
            }
        }
    }

    float vig = 1.0 / (1.0 + 0.32 * r2);
    linearOut *= (vig * vig);

    const mat3 M_AP1_to_sRGB = transpose(mat3(
         1.7050515, -0.6217921, -0.0832594,
        -0.1302564,  1.1408048, -0.0105484,
        -0.0240033, -0.1289690,  1.1529723
    ));
    vec3 srgbLin = max(M_AP1_to_sRGB * linearOut, vec3(0.0));

    vec3 graded;
    if (u_stock_type == 0u) {
        graded = pow(acesFilmicODT(srgbLin * 1.35), vec3(1.0 / 2.2));
    } else if (u_stock_type == 6u) {
        // ARRI ALEXA 35 LogC4 / REVEAL Cinema Log Output
        graded = clamp(linearToArriLogC4(srgbLin), 0.0, 1.0);
    } else {
        vec3 shoulder = srgbLin / (vec3(1.0) + srgbLin * 0.22);
        graded = pow(clamp(shoulder, 0.0, 1.0), vec3(1.0 / 2.2));
    }

    imageStore(u_output_image, outCoord, vec4(graded, 1.0));
}
